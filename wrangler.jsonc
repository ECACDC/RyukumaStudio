{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ryukumastudio",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "PAID_ASSETS",
      "bucket_name": "ryukuma-paid-assets"
    }
  ]
}
